# Copie para ~/.dbt/profiles.yml (dbt Core) — no dbt Platform a conexao e configurada na UI.
eleicoes2026:
  target: dev
  outputs:
    dev:
      type: databricks
      catalog: workspace
      schema: dbt_pedro
      host: dbc-XXXXXXXX-XXXX.cloud.databricks.com
      http_path: /sql/1.0/warehouses/XXXXXXXX
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 4
    prod:
      type: databricks
      catalog: workspace
      schema: eleicoes
      host: dbc-XXXXXXXX-XXXX.cloud.databricks.com
      http_path: /sql/1.0/warehouses/XXXXXXXX
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 8
